SELECT COUNT(@@GLOBAL.build_toolchain);

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.build_toolchain=1;

--disable_warnings
SELECT @@GLOBAL.build_toolchain = VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='build_toolchain';
--enable_warnings

SELECT @@build_toolchain = @@GLOBAL.build_toolchain;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT COUNT(@@local.build_toolchain);

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT COUNT(@@SESSION.build_toolchain);

--error ER_BAD_FIELD_ERROR
SELECT build_toolchain;
