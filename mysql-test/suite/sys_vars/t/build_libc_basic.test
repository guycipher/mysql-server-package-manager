SELECT COUNT(@@GLOBAL.build_libc);

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.build_libc=1;

--disable_warnings
SELECT @@GLOBAL.build_libc = VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='build_libc';
--enable_warnings

SELECT @@build_libc = @@GLOBAL.build_libc;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT COUNT(@@local.build_libc);

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT COUNT(@@SESSION.build_libc);

--error ER_BAD_FIELD_ERROR
SELECT build_libc;
