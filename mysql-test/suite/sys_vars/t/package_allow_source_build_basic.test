SET @start_value = @@GLOBAL.package_allow_source_build;
SELECT @start_value AS off_by_default;

SET GLOBAL package_allow_source_build = ON;
SELECT @@GLOBAL.package_allow_source_build;
SET GLOBAL package_allow_source_build = OFF;
SELECT @@GLOBAL.package_allow_source_build;

--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL package_allow_source_build = 'maybe';
--error ER_GLOBAL_VARIABLE
SET SESSION package_allow_source_build = ON;

SET GLOBAL package_allow_source_build = @start_value;
