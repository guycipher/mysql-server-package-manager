## The MySQL plugin SDK, for building extensions out of tree.
##
##   FIND_PACKAGE(MySQLSDK REQUIRED)
##   MYSQL_SDK_ADD_PLUGIN(ha_example ha_example.cc)

GET_FILENAME_COMPONENT(MYSQL_SDK_PREFIX
  "${CMAKE_CURRENT_LIST_DIR}/@SDK_PREFIX_FROM_CMAKEDIR@" ABSOLUTE)

SET(MYSQL_SDK_SERVER_VERSION "@MYSQL_NO_DASH_VERSION@")
SET(MYSQL_SDK_VERSION_ID @MYSQL_VERSION_ID@)
SET(MYSQL_SDK_PLATFORM "@MYSQL_SDK_PLATFORM@")
SET(MYSQL_SDK_CXXFLAGS "@MYSQL_SDK_CXXFLAGS@")
SET(MYSQL_SDK_LDFLAGS "@MYSQL_SDK_LDFLAGS@")
SET(MYSQL_SDK_PLUGIN_DIR "${MYSQL_SDK_PREFIX}/@INSTALL_PLUGINDIR@")

SET(MYSQL_SDK_ROOT "${MYSQL_SDK_PREFIX}/@INSTALL_SDK_INCLUDEDIR@")
SET(MYSQL_SDK_INCLUDE_DIRS
  ${MYSQL_SDK_ROOT}
  ${MYSQL_SDK_ROOT}/include
  ${MYSQL_SDK_ROOT}/libs
  ${MYSQL_SDK_ROOT}/extra/rapidjson
  ${MYSQL_SDK_ROOT}/extra/zlib
  )

FIND_LIBRARY(MYSQL_SDK_SERVICES_LIBRARY mysqlservices
  PATHS "${MYSQL_SDK_PREFIX}/@INSTALL_LIBDIR@" NO_DEFAULT_PATH)

IF(NOT EXISTS "${MYSQL_SDK_ROOT}/include/mysql/plugin.h")
  SET(MySQLSDK_FOUND FALSE)
  SET(MySQLSDK_NOT_FOUND_MESSAGE "no plugin headers in ${MYSQL_SDK_ROOT}")
  RETURN()
ENDIF()
SET(MySQLSDK_FOUND TRUE)

## MYSQL_SDK_ADD_PLUGIN(<target> <sources>...)
## A loadable plugin or component, built the way the server builds its own.
FUNCTION(MYSQL_SDK_ADD_PLUGIN TARGET)
  ADD_LIBRARY(${TARGET} MODULE ${ARGN})
  SET_TARGET_PROPERTIES(${TARGET} PROPERTIES PREFIX "")
  TARGET_INCLUDE_DIRECTORIES(${TARGET} PRIVATE ${MYSQL_SDK_INCLUDE_DIRS})

  SEPARATE_ARGUMENTS(SDK_CXXFLAGS NATIVE_COMMAND "${MYSQL_SDK_CXXFLAGS}")
  TARGET_COMPILE_OPTIONS(${TARGET} PRIVATE
    "$<$<COMPILE_LANGUAGE:CXX>:${SDK_CXXFLAGS}>")
  SEPARATE_ARGUMENTS(SDK_LDFLAGS NATIVE_COMMAND "${MYSQL_SDK_LDFLAGS}")
  TARGET_LINK_OPTIONS(${TARGET} PRIVATE ${SDK_LDFLAGS})

  IF(MYSQL_SDK_SERVICES_LIBRARY)
    TARGET_LINK_LIBRARIES(${TARGET} PRIVATE ${MYSQL_SDK_SERVICES_LIBRARY})
  ENDIF()
ENDFUNCTION()
